{
  "name": "mercury",
  "version": "0.0.0",
  "private": true,
  "description": "Mercury, the software factory.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "prebuild": "pnpm --filter @nan-builders/ai-sdk build",
    "build": "eve build",
    "check": "ultracite check",
    "predev": "pnpm --filter @nan-builders/ai-sdk build",
    "dev": "eve dev",
    "eval": "eve eval",
    "fix": "ultracite fix",
    "start": "eve start",
    "typecheck": "tsc",
    "prevalidate": "pnpm --filter @nan-builders/ai-sdk build",
    "validate": "pnpm run check && pnpm run typecheck && eve info"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@github-tools/eve-extension": "^0.3.2",
    "@nan-builders/ai-sdk": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "0.8.0",
    "ai": "^7.0.63",
    "eve": "^0.33.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@biomejs/biome": "^2.5.8",
    "@types/node": "~24.13.3",
    "typescript": "7.0.2",
    "ultracite": "^7.10.2"
  },
  "engines": {
    "node": "24.x"
  }
}
