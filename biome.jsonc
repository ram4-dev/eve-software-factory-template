{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "agent/**",
      "evals/**",
      "packages/**",
      "biome.jsonc",
      "package.json",
      "pnpm-workspace.yaml",
      "!**/dist"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        // eve derives tool/connection/skill names from filenames, and this project
        // uses snake_case (e.g. agent/tools/get_user_preferences.ts). Disable the
        // kebab-case filename rule so those names aren't flagged.
        "useFilenamingConvention": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/nan-ai-sdk/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["como-funciona.html"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
